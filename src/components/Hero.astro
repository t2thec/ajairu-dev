---
export interface Props {
  badge?: string;
  title: string;
  lead: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  badge = 'We Build Software. You Own It.',
  title,
  lead,
  primaryCtaText = 'Book a Free 30-min Discovery Call',
  primaryCtaHref = '/contact',
  secondaryCtaText = 'Take the Free Software Readiness Quiz',
  secondaryCtaHref = '/assessment',
} = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="hero-badge">{badge}</span>
        <h1 set:html={title} />
        <p class="lead">{lead}</p>
        <div class="hero-ctas">
          <a href={primaryCtaHref} class="btn btn-primary btn-lg">{primaryCtaText}</a>
          <a href={secondaryCtaHref} class="btn btn-secondary btn-lg" set:html={secondaryCtaText} />
        </div>
        <div class="hero-roi-bar">
          <div class="hero-roi-item">
            <span class="hero-roi-num">60-70%</span>
            <span class="hero-roi-label">lower build costs with AI-accelerated development</span>
          </div>
          <div class="hero-roi-divider"></div>
          <div class="hero-roi-item">
            <span class="hero-roi-num">12-18</span>
            <span class="hero-roi-label">months to break-even vs SaaS subscriptions</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card-stack">
          <div class="hero-outcome-card">
            <div class="outcome-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></div>
            <div class="outcome-content">
              <h3>Built Around Your Processes</h3>
              <p>We build software that works the way your business works. Not a template, not a vendor's workflow. Your processes, engineered properly.</p>
            </div>
          </div>
          <div class="hero-outcome-card">
            <div class="outcome-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg></div>
            <div class="outcome-content">
              <h3>Fixed Price, No Surprises</h3>
              <p>From &pound;2,000 for technical consultancy. You know the total cost before we start. No open-ended billing, no day rates.</p>
            </div>
          </div>
          <div class="hero-outcome-card">
            <div class="outcome-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.6-2-3.4-2.4.9a7 7 0 0 0-1.7-1L14.3 3h-4.6l-.5 2.9a7 7 0 0 0-1.7 1l-2.4-.9-2 3.4 2 1.6a7 7 0 0 0 0 2l-2 1.6 2 3.4 2.4-.9a7 7 0 0 0 1.7 1l.5 2.9h4.6l.5-2.9a7 7 0 0 0 1.7-1l2.4.9 2-3.4-2-1.6a7 7 0 0 0 .1-1z"/></svg></div>
            <div class="outcome-content">
              <h3>We Build It, You Own It</h3>
              <p>Working software, trained teams, full source code. When we leave, your team can run and extend everything independently.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-roi-bar {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
    padding: 16px 24px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .hero-roi-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-roi-num {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--teal);
    white-space: nowrap;
  }
  .hero-roi-label {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.3;
  }
  .hero-roi-divider {
    width: 1px;
    height: 32px;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .hero-roi-bar {
      flex-direction: column;
      gap: 12px;
    }
    .hero-roi-divider {
      width: 80%;
      height: 1px;
    }
  }
</style>