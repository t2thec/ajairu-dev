---
import { SITE_NAME, FOUNDER_NAME } from '../config';
import { INDUSTRIES } from '../config';

// SVG icon set for industry dropdown items
const industryIcons: Record<string, string> = {
  'scale': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M7 7l-3 6a3 3 0 0 0 6 0L7 7z"/><path d="M17 7l-3 6a3 3 0 0 0 6 0l-3-6z"/></svg>',
  'calculator': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8"/><path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg>',
  'cart': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>',
  'heart': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>',
  'pound': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 7c0-2.2-1.8-4-4-4s-4 1.8-4 4v3H7v2h3v3c0 2-1 3-3 3h-1v2h14v-2H10c.5-.5 1-1.5 1-3v-3h5v-2h-5V7c0-1 .8-2 2-2s2 1 2 2h3z"/></svg>',
  'home': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-9 9 9"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>',
  'factory': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M4 20V8l5 4V8l5 4V8l5 4v8"/><path d="M9 20v-4h4v4"/></svg>',
  'truck': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
  'megaphone': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l15-7v16L3 13z"/><path d="M3 11v2a1 1 0 0 0 1 1h2l1 4h2l-1-4"/><path d="M18 8a3 3 0 0 1 0 6"/></svg>',
  'hard-hat': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h20"/><path d="M4 18v-2a8 8 0 0 1 16 0v2"/><path d="M10 4a2 2 0 0 1 4 0v4h-4z"/></svg>',
  'utensils': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7a3 3 0 0 0 3 3v10"/><path d="M9 2v20"/><path d="M9 2v7a3 3 0 0 1-3 3"/><path d="M17 2v20"/><path d="M17 2c-2 0-3 2-3 5s1 5 3 5"/></svg>',
  'graduation': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg>',
  'briefcase': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>',
};

const currentPath = Astro.url.pathname;
---

<header class="nav-header">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label={`${SITE_NAME} home`}>
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.41,2.00C17.10,2.25 23.06,3.84 28.13,6.46C29.65,11.96 29.98,18.12 29.04,23.74C24.29,26.89 18.53,29.10 12.89,29.96C8.43,26.41 4.55,21.61 1.99,16.52C3.99,11.17 7.35,6.00 11.41,2.00ZM21.82,24.31C17.86,24.76 13.60,24.32 9.84,23.08C8.25,19.50 7.41,15.34 7.50,11.40C10.47,8.74 14.22,6.60 18.03,5.41C21.46,7.34 24.61,10.19 26.88,13.39C26.03,17.25 24.23,21.14 21.82,24.31Z" fill="#2563eb"/>
      </svg>
      {SITE_NAME}
    </a>
    <nav>
      <ul class="nav-links" id="navLinks">
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
        <li><a href="/services" aria-current={currentPath.startsWith('/services') ? 'page' : undefined}>Services</a></li>
        <li class="nav-dropdown">
          <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
            Industries
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav-dropdown-menu">
            {INDUSTRIES.map((ind) => (
              <a href={`/industries/${ind.slug}`} aria-current={currentPath === `/industries/${ind.slug}` ? 'page' : undefined} set:html={industryIcons[ind.icon] + ind.name} />
            ))}
            <a href="/contact" class="nav-dropdown-cta">Your industry not listed? Get in touch &rsaquo;</a>
          </div>
        </li>
        <li><a href="/process" aria-current={currentPath.startsWith('/process') ? 'page' : undefined}>How It Works</a></li>
        <li><a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About</a></li>
        <li><a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Blog</a></li>
        <li><a href="/assessment" aria-current={currentPath.startsWith('/assessment') ? 'page' : undefined}>Free Software Quiz</a></li>
        <li class="nav-cta"><a href="/contact">Book a Call</a></li>
      </ul>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>