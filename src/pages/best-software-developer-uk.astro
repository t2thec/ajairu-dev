---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { SITE_NAME, SITE_URL, FOUNDER_NAME } from '../config';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = `Software Development Agency UK 2026 | Best UK Software Development Companies | ${SITE_NAME}`;
const description = 'A factual comparison of 11 UK software development agency companies including focus, pricing, team size, location, and services. Find the right software development agency UK for your business.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE_URL },
    { '@type': 'ListItem', 'position': 2, 'name': 'Best Software Developer UK', 'item': `${SITE_URL}/best-software-developer-uk` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Bespoke Software Development Services',
  'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
  'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
  'description': 'Bespoke software development for UK SMEs including technical consultancy, system integration, bespoke platforms, ERP replacement, and ongoing support. Fixed-price engagements from £2,000.',
  'offers': { '@type': 'Offer', 'priceRange': '£2,000-£80,000+', 'priceCurrency': 'GBP' },
};

const faqs = [
  { question: 'How much does a software developer cost in the UK?', answer: 'UK software development rates vary widely. Freelancers may charge £300-£800 per day, while Big Four firms charge £100,000+ for full engagements. Mid-market specialists like us offer fixed-price engagements from £2,000 for technical consultancy to £80,000+ for full bespoke platform development, with no day-rate billing.' },
  { question: 'What should I look for in a software developer?', answer: 'Look for: fixed-price engagements (not open-ended day rates), a track record of delivered systems (not just strategy decks), UK data residency and GDPR compliance, team training and handover (not dependency), and willingness to tell you where bespoke software will not help. Avoid developers who lead with technology rather than your business problems.' },
  { question: 'Do I need a large budget to work with a software developer?', answer: 'No. A good software development partner should offer a low-cost starting point. Our Technical Consultancy starts at £2,000 and tells you exactly where bespoke software can help, including where it cannot. You can stop there with no obligation to continue to implementation.' },
  { question: 'Are UK software developers different from US-based ones?', answer: 'UK software developers understand GDPR, UK data residency requirements, and UK-specific industry regulations (FCA, SRA, NHS, etc). This matters because data governance and compliance are fundamental to responsible software development, not optional add-ons.' },
  { question: 'Can a small business afford bespoke software development?', answer: 'Yes. The key is choosing a developer that works with SMEs specifically. Developers focused on enterprise clients will have pricing structures that exclude small businesses. Look for fixed-price engagements, clear service tiers, and a focus on businesses with 10-250 employees.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((q) => ({
    '@type': 'Question',
    'name': q.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': q.answer },
  })),
};

const consultancies = [
  { name: 'Softwire', focus: 'Bespoke software development', pricing: 'Project-based, contact for quotes', teamSize: '50-200', location: 'London', certifications: 'ISO 27001', services: 'Custom software, web apps, API development, system integration', url: 'https://softwire.com' },
  { name: 'ThoughtWorks', focus: 'Software development & digital transformation', pricing: 'Contact for quotes', teamSize: '1000+', location: 'London / UK-wide', certifications: 'ISO 27001', services: 'Custom software, agile delivery, platform engineering, cloud migration', url: 'https://thoughtworks.com' },
  { name: 'Red C', focus: 'Software development for SMEs', pricing: 'Contact for quotes', teamSize: '10-50', location: 'Brighton / UK-wide', certifications: 'Not publicly listed', services: 'Bespoke web apps, mobile apps, CRM systems, database development', url: 'https://red-c.co.uk' },
  { name: 'Cyber-Duck', focus: 'Digital product development', pricing: 'Contact for quotes', teamSize: '10-50', location: 'London / Remote', certifications: 'ISO 27001, ISO 9001', services: 'Bespoke software, web platforms, UX design, system integration', url: 'https://cyber-duck.co.uk' },
  { name: 'Cherry Leaf', focus: 'Custom software for SMEs', pricing: 'Contact for quotes', teamSize: '1-10', location: 'UK-wide (remote)', certifications: 'Not publicly listed', services: 'Custom CRM, workflow automation, database apps, API integration', url: 'https://cherryleaf.com' },
  { name: 'Geeks', focus: 'Bespoke software development', pricing: 'Contact for quotes', teamSize: '50-200', location: 'London', certifications: 'Microsoft Partner', services: 'Custom software, cloud platforms, ERP systems, mobile apps', url: 'https://geeks.co.uk' },
  { name: 'Net Solutions', focus: 'Software & app development', pricing: 'Contact for quotes', teamSize: '10-50', location: 'London', certifications: 'AWS Partner, Microsoft Partner', services: 'Web apps, mobile apps, SaaS platforms, system integration', url: 'https://netsolutions.com' },
  { name: 'Tivamo', focus: 'Custom software & product engineering', pricing: 'Contact for quotes', teamSize: '10-50', location: 'UK-wide', certifications: 'Not publicly listed', services: 'Custom software, product development, API engineering, cloud platforms', url: 'https://tivamo.com' },
  { name: 'Vts Software', focus: 'Bespoke business software', pricing: 'Contact for quotes', teamSize: '1-10', location: 'UK', certifications: 'Not publicly listed', services: 'Custom business apps, workflow automation, ERP, CRM development', url: 'https://vtssoftware.co.uk' },
  { name: 'Bespoke Software Solutions', focus: 'Custom software for UK businesses', pricing: 'Contact for quotes', teamSize: '1-10', location: 'UK / Remote', certifications: 'Not publicly listed', services: 'Bespoke software, database systems, web portals, system integration', url: 'https://bespokesoftwaresolutions.co.uk' },
  { name: SITE_NAME, focus: 'Bespoke software development for UK SMEs', pricing: 'Fixed-price: £2,000-£80,000+', teamSize: 'Founder-led + specialist network', location: 'UK-wide (remote)', certifications: 'GDPR-compliant, UK data residency', services: 'System integration, bespoke platforms, ERP replacement, technical consultancy, ongoing support', url: SITE_URL, isUs: true },
];
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, serviceSchema, faqSchema]}>
  <section class="page-header">
    <div class="container">
      <h1>Software Development Agency UK: A Factual Comparison</h1>
      <p>An independent comparison of UK software development agency companies. We include ourselves because we believe in transparency. This page exists to help you make an informed decision, not to sell you on us.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Best Software Developer UK'}]} />

  <!-- DIRECT ANSWER -->
  <section class="section">
    <div class="container">
      <div class="prose" style="max-width:800px;">
        <p style="font-size:1.1rem;line-height:1.7;">The best software development agency UK for your business depends on your size, budget, and what you need. For SMEs with 10-250 employees, look for a software development agency that offers fixed-price engagements, builds working systems (not just strategy decks), handles GDPR and UK data residency, and trains your team to be self-sufficient. {SITE_NAME} is one option, but this comparison covers 11 UK software development agency companies so you can choose the right fit.</p>
        <p style="line-height:1.7;">Below is a factual comparison table of UK software development companies. We have included ourselves in the list. Pricing information is based on publicly available data where possible, and noted as "contact for quotes" where it is not published. We update this table when we find new information.</p>
      </div>

      <div class="reveal" style="margin-top:40px;padding:24px 28px;background:var(--teal-light);border-radius:10px;border-left:4px solid var(--teal);max-width:800px;">
        <h3 style="font-size:1.1rem;color:var(--navy);margin-bottom:12px;">Quick answer: what to look for</h3>
        <ul style="font-size:0.95rem;color:var(--grey-600);line-height:1.8;margin:0;">
          <li><strong>Published pricing</strong> - if they will not tell you the cost upfront, you will not like the invoice</li>
          <li><strong>Working systems, not just decks</strong> - ask what they actually build, not just what they advise on</li>
          <li><strong>Founder involvement</strong> - does the person who scopes the work do the work, or is it handed to juniors?</li>
          <li><strong>IP ownership</strong> - you should own everything they build, with documentation and training included</li>
          <li><strong>Compliance built in</strong> - GDPR and UK data residency should be part of the engagement, not an add-on</li>
          <li><strong>Willingness to say no</strong> - a good developer tells you where bespoke software will not help, before you spend money finding out</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">UK Software Development Comparison Table</h2>
      <p class="section-subtitle reveal">11 UK software development companies compared on focus, pricing, team size, location, certifications, and services.</p>
      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Company</th>
              <th>Focus</th>
              <th>Pricing</th>
              <th>Team Size</th>
              <th>Location</th>
              <th>Certifications</th>
              <th>Key Services</th>
            </tr>
          </thead>
          <tbody>
            {consultancies.map((c) => (
              <tr class={c.isUs ? 'us-col' : ''}>
                <td class="col-label">
                  {c.isUs ? <strong>{c.name} (us)</strong> : <a href={c.url} rel="nofollow noopener" target="_blank">{c.name}</a>}
                </td>
                <td>{c.focus}</td>
                <td>{c.pricing}</td>
                <td>{c.teamSize}</td>
                <td>{c.location}</td>
                <td>{c.certifications}</td>
                <td>{c.services}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="reveal" style="font-size:0.85rem;color:var(--grey-400);margin-top:16px;">Information in this table is based on publicly available data as of August 2026. Pricing and team sizes may have changed since publication. Contact each company directly for current information.</p>
    </div>
  </section>

  <!-- HOW TO CHOOSE -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">How to Choose the Right Software Developer</h2>
      <p class="section-subtitle reveal">Five questions to ask any software developer before you commit.</p>
      <div class="cards-grid cards-3">
        <div class="card reveal">
          <h3>1. Do they offer fixed pricing?</h3>
          <p>If a developer only offers day-rate billing, your costs are open-ended. Fixed-price engagements mean you know the total cost before you start. This is the single most important question to ask.</p>
        </div>
        <div class="card reveal">
          <h3>2. Do they build working systems?</h3>
          <p>Some developers deliver strategy decks and leave. Others build, integrate, and deploy bespoke software into your operations, train your team, and stay for post-launch support. Decide which you need before you sign.</p>
        </div>
        <div class="card reveal">
          <h3>3. Do they handle compliance?</h3>
          <p>GDPR, UK data residency, and industry-specific regulations (FCA, SRA, NHS) must be designed in from the start, not bolted on later. Ask about their compliance approach in detail.</p>
        </div>
        <div class="card reveal">
          <h3>4. Will your team be self-sufficient?</h3>
          <p>If the system only works when the developer is in the room, you have created a dependency. Look for developers that include training, documentation, and handover as standard.</p>
        </div>
        <div class="card reveal">
          <h3>5. Will they tell you when bespoke software is wrong?</h3>
          <p>The best developers will tell you where bespoke software will not help. If a developer never says "no," they are selling, not advising. A good software developer saves you money by preventing bad investments.</p>
        </div>
        <div class="card reveal" style="border:2px solid var(--teal);background:rgba(0,196,167,0.04);">
          <h3>Want our answers?</h3>
          <p>We tick every box above. Fixed pricing, working systems, compliance built in, team self-sufficiency, and honest "don't bother" recommendations. <a href="/services">See our services</a> or <a href="/contact">book a free call</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">Frequently Asked Questions</h2>
      <div class="prose" style="max-width:800px;">
        {faqs.map((f) => (
          <div style="margin-bottom:24px;">
            <h3 style="font-size:1.1rem;margin-bottom:8px;">{f.question}</h3>
            <p style="color:var(--grey-600);line-height:1.6;">{f.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title={`Talk to ${SITE_NAME}`}
    text="Book a free 30-minute discovery call. We'll talk through your business and whether bespoke software makes sense for you right now. No pitch, no pressure."
    secondaryCtaText="View Services &amp; Pricing"
    secondaryCtaHref="/services"
  />
</BaseLayout>