---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_NAME, SITE_URL, CONTACT_EMAIL } from '../config';

const title = `How to Replace Salesforce with Custom Software UK | ${SITE_NAME}`;
const description = 'Replace Salesforce with custom software you own. UK SMEs save £30k-£80k/year. Build vs integrate guide with cost comparison. Break-even in 12-18 months.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE_URL },
    { '@type': 'ListItem', 'position': 2, 'name': 'Replace Salesforce UK', 'item': `${SITE_URL}/replace-salesforce` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Salesforce Replacement UK',
  'serviceType': 'Custom CRM Development & Salesforce Replacement',
  'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME, 'email': CONTACT_EMAIL },
  'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
  'description': 'Replace Salesforce with custom software you own outright. UK SMEs save £30,000 to £80,000 per year with bespoke CRM development. Build vs integrate guide, cost comparison, and break-even analysis.',
  'offers': [
    { '@type': 'Offer', 'name': 'Salesforce Integration with AI', 'price': '8000', 'priceCurrency': 'GBP', 'description': 'Keep Salesforce, add an AI automation layer to connect it with your other systems. 4-12 weeks.' },
    { '@type': 'Offer', 'name': 'Custom CRM Replacement', 'price': '25000', 'priceCurrency': 'GBP', 'description': 'Replace Salesforce with bespoke CRM software you own outright. 8-16 weeks. Break-even in 12-18 months.' },
  ],
};

const faqItems = [
  { question: 'How much does it cost to replace Salesforce with custom software?', answer: 'A focused CRM replacement starts from £25,000. Larger replacements with integrations and custom workflows typically range from £40,000 to £80,000. Compare that to Salesforce Enterprise at £165/user/month: a 30-person team costs £59,000 per year before add-ons. Break-even on a custom build is 12-18 months, and you own the software forever after that.' },
  { question: 'Can a custom CRM integrate with my existing tools?', answer: 'Yes. Any tool with an API can be integrated: Xero, HubSpot, Stripe, Sage, Shopify, QuickBooks, and hundreds more. We build custom API connectors that sync data in real time, so your bespoke CRM talks to your accounting, marketing, and operations software exactly the way Salesforce did, without the per-seat licence fees.' },
  { question: 'How long does it take to replace Salesforce?', answer: 'A focused CRM replacement takes 8-16 weeks using AI-accelerated development. Your existing Salesforce stays running throughout the build, and we migrate your data in parallel. You only switch over when your team is confident in the new system. Traditional agencies quote 6-12 months for the same work.' },
  { question: 'Should I replace Salesforce or integrate it?', answer: 'If you use 20% or more of Salesforce features and your sales process is fairly standard, integrate. Keep Salesforce and add an AI automation layer to connect it with your other systems. If you use less than 20% of features and your process is unique to your business, replace it with custom software. The build-vs-buy calculator can help you decide which path fits your situation.' },
  { question: 'Do I own the source code?', answer: 'Yes, entirely. You own the source code, the database, and the infrastructure from day one. No licence fees, no vendor lock-in, no price increases. Your in-house team can modify the software, or any developer can take it over. We provide full documentation and training so you are never dependent on us.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((q) => ({
    '@type': 'Question',
    'name': q.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': q.answer },
  })),
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, serviceSchema, faqSchema]}>
  <section class="page-header">
    <div class="container">
      <h1>How to Replace Salesforce with Custom Software</h1>
      <p>Salesforce is powerful but expensive for UK SMEs. Enterprise tier costs £165 per user per month. A 30-person team costs £59,000 a year before add-ons. There is a better way: keep Salesforce and automate it, or replace it with software you own outright.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Replace Salesforce UK'}]} />

  <!-- WHAT SALESFORCE DOES WELL -->
  <section class="section" id="what-salesforce-does-well">
    <div class="container">
      <span class="eyebrow reveal" style="display:block;text-align:center;">Be Fair</span>
      <h2 class="section-title reveal">What Salesforce Does Well</h2>
      <p class="section-subtitle reveal">Salesforce earned its market position. Here is what it genuinely gets right.</p>
      <div class="cards-grid cards-4" style="margin-top:48px;">
        <div class="card reveal" style="text-align:center;padding:32px 20px;">
          <h3 style="font-size:1.1rem;color:var(--blue);">Lead Management</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);margin-top:8px;line-height:1.6;">Lead capture, scoring, routing, and pipeline tracking are mature and reliable. Few platforms match the depth here.</p>
        </div>
        <div class="card reveal" style="text-align:center;padding:32px 20px;">
          <h3 style="font-size:1.1rem;color:var(--blue);">Reporting &amp; Analytics</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);margin-top:8px;line-height:1.6;">Custom dashboards, report builders, and forecasting tools are powerful once configured. The data model is reliable.</p>
        </div>
        <div class="card reveal" style="text-align:center;padding:32px 20px;">
          <h3 style="font-size:1.1rem;color:var(--blue);">Ecosystem</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);margin-top:8px;line-height:1.6;">AppExchange has thousands of integrations. If you need a connector, someone has probably built it already.</p>
        </div>
        <div class="card reveal" style="text-align:center;padding:32px 20px;">
          <h3 style="font-size:1.1rem;color:var(--blue);">Compliance</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);margin-top:8px;line-height:1.6;">ISO 27001, SOC 2, GDPR tooling, and audit trails are enterprise-grade. For regulated industries, this matters.</p>
        </div>
      </div>
      <p class="reveal" style="max-width:760px;margin:40px auto 0;text-align:center;color:var(--grey-600);font-size:1.05rem;line-height:1.7;">None of this is in question. The problem is not what Salesforce does. The problem is what it costs UK SMEs to get there.</p>
    </div>
  </section>

  <!-- WHERE SALESFORCE FALLS SHORT -->
  <section class="section bg-grey" id="where-salesforce-fails">
    <div class="container">
      <span class="eyebrow reveal" style="display:block;text-align:center;">The Problem</span>
      <h2 class="section-title reveal">Where Salesforce Falls Short for UK SMEs</h2>
      <p class="section-subtitle reveal">The same strengths that serve enterprises actively work against smaller teams.</p>
      <div class="split-content" style="margin-top:48px;">
        <div class="reveal">
          <h3 style="margin-bottom:16px;color:var(--blue);">Per-Seat Pricing Kills SMEs</h3>
          <p style="color:var(--grey-600);line-height:1.7;">Enterprise tier is £165 per user per month. A 30-person team costs £59,000 a year before add-ons. Every new hire increases the bill. You pay the same per-seat price for the intern who logs in once a week as you do for your top salesperson.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">Add Marketing Cloud, Service Cloud, or CPQ and the annual cost easily exceeds £80,000. For an SME, that is a significant line item that grows every year.</p>
        </div>
        <div class="reveal">
          <h3 style="margin-bottom:16px;color:var(--blue);">Admin Dependency</h3>
          <p style="color:var(--grey-600);line-height:1.7;">A dedicated Salesforce admin costs £80,000 to £120,000 a year in the UK. Without one, the system drifts: workflows break, reports go stale, automation stops working. Most SMEs cannot justify a full-time admin, so the system slowly degrades.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">Every customisation requires a certified consultant. Every report change is a ticket. The platform that promised flexibility becomes a dependency.</p>
        </div>
      </div>
      <div class="cards-grid cards-3" style="margin-top:32px;">
        <div class="card reveal" style="border-top:4px solid #e53935;">
          <h3 style="font-size:1.05rem;color:#e53935;">Customisation Ceiling</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);line-height:1.7;margin-top:8px;">Apex and Lightning Web Components have limits. Deep customisation requires specialist developers at £600-£900 a day. You hit a wall where the platform fights you instead of helping you.</p>
        </div>
        <div class="card reveal" style="border-top:4px solid #e53935;">
          <h3 style="font-size:1.05rem;color:#e53935;">Data Lock-In</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);line-height:1.7;margin-top:8px;">Your data lives in Salesforce's cloud. Exporting it is deliberately difficult. Bulk API limits, report formats, and relationship structures make migration painful. Stop paying, and access disappears.</p>
        </div>
        <div class="card reveal" style="border-top:4px solid #e53935;">
          <h3 style="font-size:1.05rem;color:#e53935;">10-20% Feature Usage</h3>
          <p style="font-size:0.9rem;color:var(--grey-600);line-height:1.7;margin-top:8px;">Most UK SMEs use 10-20% of Salesforce features. You pay 100% of the licence fee for 80-90% of the platform you never touch. That unused capability adds clutter, confusion, and training overhead.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OPTION A: INTEGRATE -->
  <section class="section" id="option-a-integrate">
    <div class="container">
      <span class="eyebrow reveal" style="display:block;text-align:center;">Option A</span>
      <h2 class="section-title reveal">Integrate Salesforce with AI Automation</h2>
      <p class="section-subtitle reveal">Keep Salesforce. Add an AI layer that connects it with the rest of your business.</p>
      <div class="split-content" style="margin-top:48px;">
        <div class="reveal">
          <h3 style="color:var(--blue);margin-bottom:16px;">When This Works</h3>
          <p style="color:var(--grey-600);line-height:1.7;">If you use 20% or more of Salesforce features and your sales process is fairly standard, do not rip it out. The platform is doing its job. The problem is that it sits in isolation from your accounting, operations, and marketing tools.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">An AI automation layer solves this. We build custom APIs that sync data between Salesforce and every other system you run. Your team stops copying data manually. Decisions get made on complete information, not siloed snapshots.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">Cost: from £8,000. Timeline: 4-12 weeks. You keep your Salesforce investment and make it work harder.</p>
        </div>
        <div class="reveal">
          <h3 style="color:var(--blue);margin-bottom:16px;">What You Get</h3>
          <ul style="color:var(--grey-600);line-height:2;">
            <li><strong>Real-time data sync</strong> between Salesforce and Xero, HubSpot, Stripe, Sage, and more</li>
            <li><strong>AI-powered decisions</strong> that pull context from every system, not just CRM</li>
            <li><strong>Automated workflows</strong> that trigger actions across platforms without manual handoffs</li>
            <li><strong>Unified dashboards</strong> showing sales, finance, and operations in one place</li>
            <li><strong>You own the integration code</strong> outright, no ongoing licence fees for the automation layer</li>
          </ul>
          <a href="/services/system-integration-uk" class="btn btn-outline" style="margin-top:24px;">Explore System Integration</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OPTION B: REPLACE -->
  <section class="section bg-grey" id="option-b-replace">
    <div class="container">
      <span class="eyebrow reveal" style="display:block;text-align:center;">Option B</span>
      <h2 class="section-title reveal">Replace Salesforce with Custom Software</h2>
      <p class="section-subtitle reveal">Build a CRM that works your way. Own the code. Break even in 12-18 months.</p>
      <div class="split-content" style="margin-top:48px;">
        <div class="reveal">
          <h3 style="color:var(--blue);margin-bottom:16px;">When This Works</h3>
          <p style="color:var(--grey-600);line-height:1.7;">If you use less than 20% of Salesforce features and your sales process is unique to your business, replacing it is the better financial decision. You are already paying for a platform you mostly do not use, and bending it to fit your process is costing you consultant fees on top of the licence.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">Custom software means the CRM does exactly what your business needs, uses your terminology, and follows your workflow. No unused features. No per-seat pricing. No admin dependency.</p>
          <p style="color:var(--grey-600);line-height:1.7;margin-top:16px;">Build cost: £25,000 to £80,000. Timeline: 8-16 weeks. Break-even: 12-18 months versus £59,000+ a year on Salesforce.</p>
        </div>
        <div class="reveal">
          <h3 style="color:var(--blue);margin-bottom:16px;">What You Get</h3>
          <ul style="color:var(--grey-600);line-height:2;">
            <li><strong>A CRM built around your process</strong>, not a vendor's idea of how sales should work</li>
            <li><strong>Full source code ownership</strong>: database, infrastructure, and all intellectual property</li>
            <li><strong>No per-seat pricing</strong>: add as many users as you like at zero additional cost</li>
            <li><strong>No vendor lock-in</strong>: your in-house team or any developer can maintain it</li>
            <li><strong>AI features built in from day one</strong>, not bolted on as premium add-ons</li>
            <li><strong>Integrations included</strong> with Xero, HubSpot, Stripe, and any tool with an API</li>
          </ul>
          <a href="/services/erp-replacement-uk" class="btn btn-outline" style="margin-top:24px;">Explore ERP Replacement</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO DECIDE -->
  <section class="section" id="how-to-decide">
    <div class="container">
      <span class="eyebrow reveal" style="display:block;text-align:center;">Make the Call</span>
      <h2 class="section-title reveal">How to Decide: Integrate or Replace?</h2>
      <p class="section-subtitle reveal">Two questions will tell you which path fits your business.</p>
      <div class="cards-grid cards-2" style="margin-top:48px;">
        <div class="card reveal" style="border-top:4px solid var(--blue);">
          <h3 style="font-size:1.15rem;color:var(--blue);margin-bottom:16px;">Choose Integrate If</h3>
          <ul style="color:var(--grey-600);line-height:1.9;">
            <li>You use 20% or more of Salesforce features</li>
            <li>Your sales process is fairly standard</li>
            <li>Your team is comfortable with the Salesforce interface</li>
            <li>The main pain is disconnected systems, not the CRM itself</li>
            <li>You want results in 4-12 weeks, not a full rebuild</li>
          </ul>
          <a href="/services/system-integration-uk" class="btn btn-outline" style="margin-top:20px;">Explore Integration</a>
        </div>
        <div class="card reveal" style="border-top:4px solid var(--blue);">
          <h3 style="font-size:1.15rem;color:var(--blue);margin-bottom:16px;">Choose Replace If</h3>
          <ul style="color:var(--grey-600);line-height:1.9;">
            <li>You use less than 20% of Salesforce features</li>
            <li>Your sales process is unique to your business</li>
            <li>Per-seat pricing is a real financial burden</li>
            <li>You want to own the software outright</li>
            <li>You are spending £40,000+ a year on Salesforce before add-ons</li>
          </ul>
          <a href="/services/erp-replacement-uk" class="btn btn-outline" style="margin-top:20px;">Explore Replacement</a>
        </div>
      </div>
      <div class="reveal" style="text-align:center;margin-top:40px;">
        <p style="color:var(--grey-600);font-size:1.05rem;margin-bottom:20px;">Still unsure? Use our free calculator to get a clear recommendation based on your actual situation.</p>
        <a href="/build-vs-buy" class="btn btn-primary btn-lg">Try the Build vs Buy Calculator</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-grey" id="faq">
    <div class="container">
      <h2 class="section-title reveal">Salesforce Replacement FAQs</h2>
      <p class="section-subtitle reveal">The questions UK SMEs ask before deciding whether to integrate or replace Salesforce.</p>
      <FAQ items={faqItems} />
    </div>
  </section>

  <CTASection
    title="Not Sure Whether to Integrate or Replace?"
    text="Book a free 30-minute discovery call. We will look at your actual Salesforce usage, calculate what you spend versus what a custom build would cost, and tell you honestly which path makes financial sense for your business. No hard sell."
    primaryCtaText="Book a Free Discovery Call"
    primaryCtaHref="/contact"
    secondaryCtaText="View All Services &amp; Pricing"
    secondaryCtaHref="/services"
  />
</BaseLayout>